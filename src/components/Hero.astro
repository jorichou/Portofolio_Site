        <h1 class="hero-message">Welcome to Ryousuke's</h1>
        <h1 class="hero-message">Web Site!</h1>
    </div>
    <div class="hero-img">
        <img src="/izuchi-logo2.svg" alt="ヒーローのロゴ">
    </div> -->
    <div class="bg-slide">
        <div class="img-01"><img src="/images/hero-slide/260614194404856.JPG" alt="slide 1"></div>
        <div class="img-02"><img src="/images/hero-slide/260112144151611.JPG" alt="slide 2"></div>
    </div>
</div>