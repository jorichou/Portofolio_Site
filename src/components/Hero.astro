---
const slideImages = [
    "/images/hero-slide/240629165501671.JPG",
    "/images/hero-slide/250213091942541.JPG",
    "/images/hero-slide/250525131335388.JPG",
    "/images/hero-slide/251102162009288.JPG",
    "/images/hero-slide/260614194404856.JPG",
];
---

<style>
    .hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-direction: column;
        background-color: white;
        height: clamp(400px, 50vh, 600px);
        max-height: 800px;
        width: 100%;
    }

    .bg-slide {
        position: relative;
        width: 100vw;
        height: 100%;
        overflow: hidden;
    }

    .bg-slide::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background-color: rgba(0, 0, 0, .5);
        z-index: 2;
    }

    .slide-item {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
        z-index: 1;
    }

    .slide-item.active {
        opacity: 1;
    }

    .slide-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .message-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hero-message {
        color: #FAE8EA;
        font-size: 1.5rem;
        margin: 5px 0;
        font-family: 'Noto Sans', 'Google Sans Flex', sans-serif;
    }

    .hero-img {
        width: fit-content;
        margin: 5vw 0;
    }

    .hero-img img {
        width: 40vw;
    }

    @media screen and (min-width: 636px) {
        .hero {
            display: flex;
            align-items: center;
            flex-direction: row;
            justify-content: space-between;
            background-color: #E86B79;
            height: clamp(600px, 60vh, 800px);
            width: 100%;
            margin-bottom: 10vh;
        }

        .message-box {
            display: flex;
            flex-direction: column;
            justify-content: left;
        }
    
        .hero-message {
            font-size: 2.5rem;
        }

        .hero-img img {
            width: 22vw;
        }

    }
</style>

<div class="hero">
    <div class="bg-slide">
        {slideImages.map((src, index) => (
            <div class={`slide-item ${index === 0 ? 'active' : ''}`}>
                <img src={src} alt={`ヒーロースライド画像 ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} />
            </div>
        ))}
    </div>
</div>

<script>
    function setupHeroSlide() {
        const slides = document.querySelectorAll('.bg-slide .slide-item');
        if (slides.length <= 1) return;

        let currentIndex = 0;
        const intervalTime = 5000; // 5秒ごとに切り替え

        setInterval(() => {
            slides[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % slides.length;
            slides[currentIndex].classList.add('active');
        }, intervalTime);
    }

    // Astroのページ遷移（View Transitions）や初期読み込みの両方に対応
    document.addEventListener('astro:page-load', setupHeroSlide);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupHeroSlide);
    } else {
        setupHeroSlide();
    }
</script>